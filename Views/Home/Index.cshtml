@{
    ViewBag.Title = "Padel APP";
}

<style>
    .card-image-container {
        position: relative;
        overflow: hidden;
        border-radius: 15px;
        height: 200px;
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .card-image-container:hover .card-image {
        transform: scale(1.1);
    }

    .card-header-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 10px;
        text-align: center;
    }

    .card-footer {
        text-align: center;
        padding: 10px;
    }

    .btn-ingresar {
        background-color: #4CAF50;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

        .btn-ingresar:hover {
            background-color: #45a049;
        }

    .seccion-clara {
        background-color: #f8f9fa;
    }

    .seccion-oscura {
        background-color: #e9ecef;
    }

    .slick-prev:before, .slick-next:before {
        color: #4CAF50;
    }

    .ultimos-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #4CAF50;
    }
</style>

<div class="container-fluid py-5 seccion-clara">
    <h2 class="text-center mb-4">Clubes Asociados</h2>

    <div class="slider responsive" id="sliderClub">
        @for (int i = 1; i <= 4; i++)
        {
            <a href="#" class="card border-0 shadow-sm mx-2">
                <div class="card-image-container">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQI2ZSLDWr6zqoF4mKx_J5_AgJfv8fx76oSvw&s" alt="Club @i" class="card-image" />
                    <div class="card-header-overlay">
                        <h5 class="mb-0">Club Ejemplo @i</h5>
                    </div>
                </div>
            </a>
        }
    </div>
</div>

<div class="container-fluid py-5 seccion-oscura">
    <div class="row justify-content-center">
        @*<div class="col-md-5 mb-4">
            <div class="card h-100 border-0 shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center mb-0">RESERVA TU CANCHA</h3>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="lead text-center">Reserva tus horarios y disfruta de nuestros servicios.</p>
                    <div class="text-center">
                        <a class="btn btn-success btn-lg" href="@Url.Action("Reserva", "Home")">
                            <i class="bi bi-calendar-plus me-2"></i>Reservar
                        </a>
                    </div>
                </div>
            </div>
        </div>*@

        <div class="d-flex justify-content-center col-md-6 mb-4">
            <div class="card h-100 border-0 shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center mb-0">CREA TU PARTIDO</h3>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="lead text-center">Reserva tu cancha y ¡arma tu partido! 🎾 Si faltan jugadores, otros podrán unirse a tu reserva para disfrutar juntos del juego. 🤝</p>
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-success" href="@Url.Action("Disponibles", "Partido")">
                            <i class="bi bi-joystick me-2"></i>Unirse
                        </a>
                        <a class="btn btn-success" href="@Url.Action("Crear", "Partido")">
                            <i class="bi bi-calendar-plus me-2"></i>Crear
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center mb-0">Partidos disponibles</h3>
                </div>
                <div class="card-body">
                    <div id="partidosContainer" class="slider responsive">
                        <!-- Se generará dinámicamente aquí -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $('#sliderClub').slick({
            dots: true,
            infinite: false,
            slidesToShow: 4,
            slidesToScroll: 4,
            responsive: [
                {
                    breakpoint: 1024,
                    settings: {
                        slidesToShow: 3,
                        slidesToScroll: 3,
                        infinite: true,
                        dots: true
                    }
                },
                {
                    breakpoint: 920,
                    settings: {
                        slidesToShow: 2,
                        slidesToScroll: 2
                    }
                },
                {
                    breakpoint: 600,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1
                    }
                }
            ]
        });



        $.ajax({
            url: '@Url.Action("PartidosDisponibles", "Partido")', // Reemplaza con la URL correcta
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                const partidosContainer = $('#partidosContainer');
                let idPartido = 0;
                let urlVerPartido = "";


                $.each(data, function (index, partido) {
                    idPartido = partido.Id;
                    urlVerPartido = "@Url.Action("Ver", "Partido")?idPartido=" + idPartido;
                    console.log(urlVerPartido);

                    const card = $('<div class="card col-sm-12 border-left-primary shadow m-3 seccion-clara text-black">');
                    const cardBody = $('<div class="card-body row g-0 d-flex justify-content-center">');

                    const colJugadores1y2 = $('<div class="d-flex text-center justify-content-center">');

                    const colJugador1 = $('<div class="col-md-6 col-sm-6 text-center p-5">');
                    colJugador1.append('<img src="' + partido.FotoPerfil1 + '" alt="Foto Jugador 1" class="ultimos-img mx-auto" />');
                    colJugador1.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.Categoria1 ?? '' + '</div>');
                    colJugador1.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.UsuarioJ1 ?? '' + '</div>');

                    const colJugador2 = $('<div class="col-md-6 col-sm-6 text-center p-5">');
                    colJugador2.append('<img src="' + partido.FotoPerfil2 + '" alt="Foto Jugador 2" class="ultimos-img mx-auto" />');
                    colJugador2.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.Categoria2 ?? '' + '</div>');
                    colJugador2.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.UsuarioJ2 ?? '' + '</div>');


                    colJugadores1y2.append(colJugador1);
                    colJugadores1y2.append(colJugador2);

                    const colVs = $('<div class="col-sm-6 col-md-12 text-center mt-3 d-flex justify-content-center">');
                    colVs.append('<h2>VS</h2>');

                    const colJugadores3y4 = $('<div class="d-flex text-center justify-content-center">');

                    const colJugador3 = $('<div class="col-md-6 col-sm-6 text-center p-5">');
                    colJugador3.append('<img src="' + partido.FotoPerfil3 + '" alt="Foto Jugador 1" class="ultimos-img mx-auto" />');
                    colJugador3.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.Categoria3 ?? '' + '</div>');
                    colJugador3.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.UsuarioJ3 ?? '' + '</div>');


                    const colJugador4 = $('<div class="col-md-6 col-sm-6 text-center p-5">');
                    colJugador4.append('<img src="' + partido.FotoPerfil4 + '" alt="Foto Jugador 2" class="ultimos-img mx-auto" />');
                    colJugador4.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.Categoria4 ?? '' + '</div>');
                    colJugador4.append('<div class="col-md-12 d-flex justify-content-center text-center">' + partido.UsuarioJ4 ?? '' + '</div>');


                    colJugadores3y4.append(colJugador3);
                    colJugadores3y4.append(colJugador4);


                    const colFecha = $('<div class="col-md-12 col-sm-12 d-flex justify-content-center">');
                    colFecha.append('<h5 class="text-center">Fecha: ' + moment(partido.HorarioDesde).format('DD/MM/YYYY') + '</h5>');

                    const colUbicacion = $('<div class="col-md-12 col-sm-12 d-flex justify-content-center">');
                    colUbicacion.append('<p class="card-text text-center mb-3"> <i class="bi bi-geo-alt me-2"></i>' + partido.NombreClub + '</p>');

                    const colHorario = $('<div class="col-md-12 col-sm-12 d-flex justify-content-center">');
                    colHorario.append('<p class="card-text text-center mb-3"> <i class= "bi bi-clock me-2" ></i > ' + formatearHora(partido.HorarioDesde) + " - " + formatearHora(partido.HorarioHasta) + '</p>');


                    const colBtn = $('<div class="col-md-4 col-sm-8 d-flex justify-content-center p-1">');
                    colBtn.append($('<a class="btn btn-success" href="' + urlVerPartido + '">Unirme</a>'));

                    cardBody.append(colJugadores1y2);
                    cardBody.append(colVs);
                    cardBody.append(colJugadores3y4);


                    cardBody.append(colFecha);
                    cardBody.append(colUbicacion);
                    cardBody.append(colHorario);
                    cardBody.append(colBtn);
                    card.append(cardBody);
                    partidosContainer.append(card);

                });
                partidosContainer.slick({
                    dots: true,
                    infinite: false,
                    speed: 300,
                    slidesToShow: 4,
                    slidesToScroll: 4,
                    responsive: [
                        {
                            breakpoint: 1024,
                            settings: {
                                slidesToShow: 3,
                                slidesToScroll: 3,
                                infinite: true,
                                dots: true
                            }
                        },
                        {
                            breakpoint: 920,
                            settings: {
                                slidesToShow: 1,
                                slidesToScroll: 1
                            }
                        },
                        {
                            breakpoint: 600,
                            settings: {
                                slidesToShow: 1,
                                slidesToScroll: 1
                            }
                        },
                        {
                            breakpoint: 480,
                            settings: {
                                slidesToShow: 1,
                                slidesToScroll: 1
                            }
                        }
                    ]
                });
            },
            error: function (error) {
                console.error('Error al obtener los datos de los partidos:', error);
            }
        });

        function formatearHora(fechaString) {
            const fechaMilisegundos = parseInt(fechaString.substr(6));
            const fechaDesde = moment(fechaMilisegundos).tz('America/Chicago');
            const horaYMinutos = fechaDesde.format('HH:mm');
            console.log("Esto es de la configuración: " + horaYMinutos);

            return horaYMinutos;
        }
    });
</script>