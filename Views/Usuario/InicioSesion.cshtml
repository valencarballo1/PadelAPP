
@{
    ViewBag.Title = "InicioSesion";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <form id="loginForm">
                        <div class="mb-4">
                            <label for="nombreUsuario" class="form-label">Nombre de usuario</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" id="nombreUsuario" name="nombreUsuario" class="form-control" placeholder="Ingrese su nombre de usuario">
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="contrasena" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input type="password" id="contrasena" name="contrasena" class="form-control" placeholder="Ingrese su contraseña">
                                <button class="btn btn-outline-secondary" type="button" id="mostrarContrasena">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-success" id="inicioSesion">Iniciar Sesión</button>
                        </div>
                    </form>
                    <div class="text-center mt-4">
                        <p>¿No tienes cuenta? <a href="@Url.Action("Registro", "Usuario")" class="btn btn-warning btn-sm">Regístrate</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
        const inicioSesion = document.getElementById('inicioSesion');
        const usuarioNombre = document.getElementById('nombreUsuario');
        const contrasena = document.getElementById('contrasena');

        inicioSesion.addEventListener('click', () => {
            enEspera();
            if (usuarioNombre.value.length == 0) {
                Swal.fire({
                    title: "Error",
                    text: "El nombre de usuario no puede estar vacio!",
                    icon: "error",
                    showConfirmButton: true
                });
            }

            if (contrasena.value.length == 0) {
                Swal.fire({
                    title: "Error",
                    text: "La contraseña no puede estar vacia!",
                    icon: "error",
                    showConfirmButton: true
                });
            }

            if (usuarioNombre.value.length > 0 && contrasena.value.length > 0) {
                console.log(usuarioNombre.value + "" + contrasena.value);
                $.ajax({
                    url: "@Url.Action("LogIn", "Usuario")",
                    type: "GET",
                    data: {
                        usuarioNombre: usuarioNombre.value.toString(),
                        contrasena: contrasena.value.toString()
                    },
                    success: function (response) {
                        console.log(response);
                        enEspera("chau");
                        if (response != null) {
                            Swal.fire({
                                title: "Bienvenido " + response.Nombre,
                                text: "Iniciaste sesion correctamente!",
                                icon: "success",
                                showConfirmButton: true
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location = "@Url.Action("Index", "Home")";
                                }
                            });
                        }
                        else
                        {
                            Swal.fire({
                                title: "Error",
                                text: "Datos incorrectos, por favor vuelva a verificarlos!",
                                icon: "error",
                                showConfirmButton: true
                            }).then((result) => {
                                contrasena.value = "";
                            });
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        Swal.fire({
                            title: "Error",
                            text: "Datos incorrectos, por favor vuelva a verificarlos!",
                            icon: "error",
                            showConfirmButton: true
                        }).then((result) => {
                            contrasena.value = "";
                        });
                    }
                });
            }
        });
</script>


