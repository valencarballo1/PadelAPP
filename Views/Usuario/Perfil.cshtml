
@{
    ViewBag.Title = "Perfil";
}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <img src="@Url.Content(Model.FotoPerfil)" alt="Foto de perfil" class="profile-img mb-3">
                            <h2 class="fw-bold">@Model.NombreUsuario</h2>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-center align-items-center mb-3">
                                <i class="bi bi-telephone-fill me-2 text-primary"></i>
                                <span class="h5 mb-0 me-2">Celular:</span>
                                <span id="spanCelular">@Model.Celular</span>
                                <button class="btn btn-sm btn-outline-primary ms-2" id="editarNumero">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                            <div class="d-flex justify-content-center align-items-center">
                                <i class="bi bi-star-fill me-2 text-warning"></i>
                                <span class="h5 mb-0 me-2">Categoría:</span>
                                <span>@Model.Categoria - PTOS. @Model.Puntuacion</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 col-lg-6 mx-auto">
                            <button type="button" class="btn btn-primary" id="btnVerReservas">
                                <i class="bi bi-calendar-check me-2"></i>Ver Mis Reservas
                            </button>
                            <button type="button" class="btn btn-primary" id="btnVerUltimosPartidos">
                                <i class="bi bi-trophy me-2"></i>Ver Mis Últimos Partidos
                            </button>
                            <button class="btn btn-danger" id="cerrarSesion">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para editar número de celular -->
    <div class="modal fade" id="editarNumeroModal" tabindex="-1" aria-labelledby="editarNumeroModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editarNumeroModalLabel">Editar Número de Celular</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nuevoCelularInput" class="form-label">Nuevo Número de Celular:</label>
                        <input type="text" class="form-control" id="nuevoCelularInput">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="guardarCambiosModal">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para ver reservas -->
    <div class="modal fade" id="modalReservas" tabindex="-1" aria-labelledby="modalReservasLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalReservasLabel">Mis Reservas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Aquí se cargaría dinámicamente el contenido de las reservas -->
                    <p>Contenido de las reservas...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para ver últimos partidos -->
    <div class="modal fade" id="modalUltimosPartidos" tabindex="-1" aria-labelledby="modalUltimosPartidosLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalUltimosPartidosLabel">Mis Últimos Partidos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Aquí se cargaría dinámicamente el contenido de los últimos partidos -->
                    <p>Contenido de los últimos partidos...</p>
                </div>
            </div>
        </div>
    </div>

    <script>
    const idUsuario = @Model.Id;
    const cerrarSesion = document.getElementById('cerrarSesion');
    const editarNumero = document.getElementById('editarNumero');
    const spanCelular = document.getElementById("spanCelular");

    cerrarSesion.addEventListener('click', function () {
        $.ajax({
        url: '@Url.Action("CerrarSesion", "Usuario")',
        type: 'GET',
        data: { },
        success: function (response) {
            if (response.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Gracias por elegirnos!',
                    showConfirmButton: false,
                    timer: 1000
                }).then(function() {
                                // Redirigir a la vista Producto/VerTodos después de 5 segundos
                                window.location.href = '@Url.Action("Index", "Home")';
                            });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: response.message
                });
            }
        },

        });
    });

    editarNumero.addEventListener("click", function () {
        document.getElementById("nuevoCelularInput").value = spanCelular.textContent;
        $('#editarNumeroModal').modal('show');
    });

    document.getElementById("guardarCambiosModal").addEventListener("click", function () {
        const nuevoCelular = document.getElementById("nuevoCelularInput").value.trim();;

        enEspera();
        $.ajax({
            url: "@Url.Action("CambioCelular", "Usuario")",
            type: 'POST',
            data: { nuevoCelular: nuevoCelular },
            success: function (response) {
                enEspera("chau");
                console.log("Número de celular actualizado con éxito:", response);
                Swal.fire({
                    icon: 'success',
                    title: 'Numero actualizado!',
                    showConfirmButton: false,
                    timer: 1000
                }).then(function () {
                    location.reload();
                });
            },
            error: function (error) {
                enEspera("chau");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: "No se pudo modificar correctamente"
                });
            }
        });

        // Ocultar el modal
        $('#editarNumeroModal').modal('hide');
    });

    $('#btnVerUltimosPartidos').click(function () {
        cargarUltimosPartidos();
    });

    $('#btnVerReservas').click(function () {
        cargarReservasUsuario();
    });


    function cargarReservasUsuario() {
        $.ajax({
            url: '@Url.Action("ReservasUsuario", "Partido")',
            type: 'GET',
            data: { idUsuario: idUsuario },
            success: function (data) {
                $('#modalReservas .modal-body').html(data);
                $('#modalReservas').modal('show');
            },
            error: function () {
                console.log('Error al cargar las reservas del usuario.');
            }
        });
    }

    function cargarUltimosPartidos() {
        $.ajax({
            url: '@Url.Action("Ultimos", "Partido")',
            type: 'GET',
            data: { idUsuario: idUsuario },
            success: function (data) {
                $('#modalUltimosPartidos .modal-body').html(data);
                $('#modalUltimosPartidos').modal('show');
            },
            error: function () {
                console.log('Error al cargar los últimos partidos.');
            }
        });
    }

    </script>
