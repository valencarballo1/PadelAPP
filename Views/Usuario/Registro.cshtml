@{
    ViewBag.Title = "Registro";
}

<style>
    .form-control:focus,
    .form-select:focus {
        border-color: #4CAF50;
        box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
    }

    .input-group-text {
        background-color: #4CAF50;
        color: white;
        border: none;
    }

</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center py-3">
                    <h2 class="mb-0">REGISTRO</h2>
                </div>
                <div class="card-body p-4">
                    <div class="progress mb-4">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <form id="formularioRegistro" enctype="multipart/form-data" action="@Url.Action("Registrarme", "Usuario")" method="POST">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="nombre" class="form-label">Nombre</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa fa-tennis-ball"></i></span>
                                    <input type="text" id="nombre" name="nombre" class="form-control" placeholder="Nombre" required>
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6">
                                <label for="apellido" class="form-label">Apellido</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa fa-tennis-ball"></i></span>
                                    <input type="text" id="apellido" name="apellido" class="form-control" placeholder="Apellido" required>
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6">
                                <label for="celular" class="form-label">Número celular</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                    <input type="tel" id="celular" name="celular" class="form-control" placeholder="1199999999" required>
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6">
                                <label for="selectCategorias" class="form-label">Categoria</label>
                                <select id="selectCategorias" class="form-select" name="categoriaId" required>
                                    <option value="">Selecciona tu categoría</option>
                                </select>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-12 text-center mb-4">
                                <label for="fotoPerfil" class="form-label d-block">Foto de perfil</label>
                                <div class="position-relative d-inline-block">
                                    <img src="#" alt="Vista Previa" class="profile-img d-none mb-2" id="vistaPrevia">
                                    <div class="position-absolute bottom-0 end-0">
                                        <label for="fotoPerfil" class="btn btn-sm btn-success rounded-circle">
                                            <i class="bi bi-camera"></i>
                                        </label>
                                        <input type="file" name="fotoPerfil" id="fotoPerfil" class="d-none" accept="image/*">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="usuario" class="form-label">Usuario</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" id="usuario" name="usuario" class="form-control" required>
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6">
                                <label for="contrasena" class="form-label">Contraseña</label>
                                <div class="input-group">
                                    <input type="password" id="contrasena" name="contrasena" class="form-control" required>
                                    <button class="btn btn-outline-secondary" type="button" id="mostrarContrasena">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success w-100" id="crearUsuario">Crear Usuario</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        let nombreInput = document.getElementById('nombre');
        let apellidoInput = document.getElementById('apellido');
        let usuarioNombre = document.getElementById('usuario');
        const crearUsuario = document.getElementById('crearUsuario');
        const celular = document.getElementById('celular');
        let fotoAdjunta;
        let nombreIngresado = false;
        let apellidoIngresado = false;
        let usuarioExiste = false;

        const formInputs = document.querySelectorAll('#formularioRegistro input, #formularioRegistro select');
        const progressBar = document.querySelector('.progress-bar');

        function updateProgress() {
            const totalFields = formInputs.length;
            const filledFields = Array.from(formInputs).filter(input => input.value.trim() !== '').length;
            const progress = (filledFields / totalFields) * 100;
            progressBar.style.width = `${progress}%`;
            progressBar.setAttribute('aria-valuenow', progress);
        }

        formInputs.forEach(input => input.addEventListener('input', updateProgress));

        $.ajax({
            url: "@Url.Action("GetAll", "Categoria")",
            type: 'GET',
            dataType: 'json',
            success: function (categorias) {
                construirOpcionesSelect(categorias);
            },
            error: function (error) {
                console.error('Error al obtener las categorías:', error);
            }
        });

        document.getElementById('fotoPerfil').addEventListener('change', function (e) {
            let vistaPrevia = document.getElementById('vistaPrevia');
            vistaPrevia.classList.remove('d-none');

            let archivo = e.target.files[0];
            let lector = new FileReader();
            fotoAdjunta = archivo;

            lector.onload = function (e) {
                vistaPrevia.src = e.target.result;
            };

            lector.readAsDataURL(archivo);
            updateProgress();
        });

        nombre.addEventListener('blur', () => {
            if (nombre.value.length > 0) {
                nombreIngresado = true;
                nombreInput = nombre.value;
            }
            updateProgress();
        });

        apellido.addEventListener('blur', () => {
            if (apellido.value.length > 0) {
                apellidoIngresado = true;
                apellidoInput = apellido.value;
            }
            updateProgress();
        });

        apellido.addEventListener('focusout', () => {
            if (nombreIngresado == true && apellidoIngresado == true) {
                UsuarioGenerico(nombreInput, apellidoInput);
            } else {
                usuarioNombre.value = "";
            }
            updateProgress();
        });

        function showFeedback(element, isValid, message) {
            const inputGroup = element.closest('.input-group') || element.parentElement;
            const feedbackElement = inputGroup.nextElementSibling;

            if (feedbackElement && feedbackElement.classList.contains('feedback')) {
                feedbackElement.textContent = message;
                feedbackElement.className = 'feedback ' + (isValid ? 'text-success' : 'text-danger');
            }

            element.classList.toggle('is-valid', isValid);
            element.classList.toggle('is-invalid', !isValid);
        }

        celular.addEventListener('input', function () {
            const isValid = this.value.length === 10;
            showFeedback(this, isValid, isValid ? 'OK' : 'Num. Invalido');
            updateProgress();
        });

        const UsuarioGenerico = (nombre, apellido) => {
            usuarioNombre.value = (nombre + '.' + apellido).replace(/\s/g, '');
            const inputEvent = new Event('input', { bubbles: true });
            usuarioNombre.dispatchEvent(inputEvent);
        }

        usuarioNombre.addEventListener('input', function () {
            $.ajax({
                url: '@Url.Action("GetByUsuarioNombre", "Usuario")',
                type: 'GET',
                data: {
                    usuarioNombre: usuarioNombre.value
                },
                success: function (data) {
                    usuarioExiste = data;
                    const isValid = !usuarioExiste;
                    showFeedback(usuarioNombre, isValid, isValid ? 'Disponible' : 'Usuario Existente');
                },
                error: function (error) {
                    console.error('Error al verificar usuario:', error);
                }
            });
            updateProgress();
        });

        document.getElementById('mostrarContrasena').addEventListener('click', function () {
            const contrasenaInput = document.getElementById('contrasena');
            const iconoOjo = this.querySelector('i');

            if (contrasenaInput.type === 'password') {
                contrasenaInput.type = 'text';
                iconoOjo.classList.remove('bi-eye');
                iconoOjo.classList.add('bi-eye-slash');
            } else {
                contrasenaInput.type = 'password';
                iconoOjo.classList.remove('bi-eye-slash');
                iconoOjo.classList.add('bi-eye');
            }
        });

        function construirOpcionesSelect(categorias) {
            const select = $('#selectCategorias');

            select.empty();
            select.append('<option value="">Selecciona tu categoría</option>');

            categorias.forEach(function (categoria) {
                select.append('<option value="' + categoria.Id + '">' + categoria.Nombre + '</option>');
            });

            select.on('change', function () {
                const valorSeleccionado = $(this).val();
                console.log('Valor seleccionado:', valorSeleccionado);
                updateProgress();
            });
        }

        $("#formularioRegistro").submit(function (e) {
            e.preventDefault();
            enEspera();
            var formData = new FormData(this);

            $.ajax({
                url: $(this).attr("action"),
                type: $(this).attr("method"),
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    enEspera("chau");
                    if (response > 0) {
                        Swal.fire({
                            title: "Registro confirmado!",
                            text: "Tu usuario esta activo. Puedes reservar y crear partidos!",
                            icon: "success",
                            showConfirmButton: true
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location = "@Url.Action("Index", "Home")";
                            }
                        });
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    enEspera("chau");
                    Swal.fire({
                        title: "Error!",
                        text: "Hubo un error en el registro!",
                        icon: "error",
                        showConfirmButton: true
                    });
                }
            });
        });
    });
</script>